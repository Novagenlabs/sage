generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String?
  image          String?
  emailVerified  DateTime?
  credits        Int       @default(200)
  profileSummary String?   @db.Text // Consolidated summary of what Sage knows about user
  // v2 onboarding fields — set during /v2/onboarding/*
  birthday       DateTime?
  preferredTopics String[] @default([])
  // App-lock passcode (4-digit, bcrypt hash). Empty = no lock.
  passcodeHash   String?
  referralCode  String?   @unique
  referredById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  referredBy    User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers User[]    @relation("UserReferrals")
  accounts      Account[]
  sessions      Session[]
  usageRecords  UsageRecord[]
  conversations Conversation[]
  userInsights  UserInsight[]
  payments      Payment[]
  referrals     Referral[]
  feedback      Feedback[]
  recommendations Recommendation[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  phase     String   @default("opening")
  summary   String?  @db.Text // AI-generated summary for context injection
  isActive  Boolean  @default(true) // Is this the current active conversation?
  // v2 post-session annotations — set on /v2/entries/active
  color     String?  // hex or palette key chosen by user (e.g. "ember", "plum")
  moods     String[] @default([]) // mood chips selected on /v2/mood
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  insights     ConversationInsight[]
  usageRecords UsageRecord[]
  recommendations Recommendation[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  phase          String?
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id               String   @id @default(cuid())
  userId           String
  conversationId   String?
  type             String // "chat", "voice", "summary", "profile", "insights", "tts", "stt"
  category         String   @default("user") // "user", "system", "background"
  service          String   @default("openrouter") // "openrouter", "openai", "elevenlabs", "deepgram", "livekit"
  tokensUsed       Int
  promptTokens     Int?
  completionTokens Int?
  creditsUsed      Int
  costUsd          Float? // Actual USD cost from provider API
  modelId          String?
  source           String? // Code path identifier e.g. "api/chat", "inngest/generate-summary"
  isEstimate       Boolean  @default(false) // true when tokens are estimates, not from provider API
  durationMs       Int? // API call latency or audio duration
  status           String   @default("success") // "success", "error"
  errorMessage     String?  @db.Text
  metadata         Json? // Extensible data (e.g. ElevenLabs chars, Deepgram audio secs)
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@index([userId, type, createdAt])
}

model ConversationInsight {
  id             String   @id @default(cuid())
  conversationId String
  content        String   @db.Text
  type           String // "realization", "assumption", "pattern", "question"
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UserInsight {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text // e.g., "Tends to overthink decisions"
  category   String // "pattern", "preference", "goal", "behavior"
  confidence Float    @default(0.5) // 0-1, how reliable this insight is
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  reference String   @unique
  amount    Int // Amount in kobo
  credits   Int
  status    String   @default("pending") // pending, success, failed
  provider  String   @default("paystack")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  status         String    @default("pending") // pending|qualified|rejected
  creditsPaid    Int       @default(0)
  qualifiedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
}

// Password reset token. We store only the bcrypt hash of the random token
// the user receives — if the table is leaked, the tokens in it are useless.
// Tokens expire after 1 hour and are marked used (single-use) on success.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Hand-curated catalog of resources Sage can recommend (books, articles,
// lectures, podcasts, videos, audiobooks). Themes are free-form pattern tags
// that the matcher prompt reads alongside the user's profileSummary to
// decide if a resource fits a session. New entries are added via the admin
// UI at /admin/resources, no redeploy needed.
model Resource {
  id          String   @id @default(cuid())
  type        String   // "book" | "article" | "lecture" | "podcast" | "video" | "audiobook"
  title       String
  author      String?
  url         String   // canonical link the user opens
  blurb       String   @db.Text          // 1-2 sentences for the recommendation card
  themes      String[] @default([])      // free-form pattern tags
  why         String   @db.Text          // 1-3 sentences: when/why a Sage user benefits
  // Path under /public to a Sage-narrated audio intro for this resource,
  // generated via ElevenLabs from (title + author + blurb + why). Optional —
  // when null, the player falls back to external link or YouTube embed.
  audioUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recommendations Recommendation[]

  @@index([isActive])
}

// One recommendation Sage made to a user. Tied to the conversation that
// triggered it (nullable for cross-session recs in the future). Captures
// feedback so future matches can exclude dismissed resources and lean
// toward themes the user has marked helpful.
model Recommendation {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  resourceId     String
  reason         String    @db.Text   // Sage's one-sentence "why I'm suggesting this"
  feedback       String?              // "helpful" | "not_for_me" | null
  feedbackAt     DateTime?
  clickedAt      DateTime?            // user opened the resource URL
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  resource     Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
}

// v2 product feedback — submitted from /v2/profile/feedback.
// userId is optional so future unauth feedback paths still work.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?  // optional reply address the user types in
  message   String   @db.Text
  source    String   @default("v2") // "v2" | future surfaces
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
