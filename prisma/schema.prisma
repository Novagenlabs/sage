generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String?
  image          String?
  emailVerified  DateTime?
  credits        Int       @default(200)
  profileSummary String?   @db.Text // Consolidated summary of what Sage knows about user
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  usageRecords  UsageRecord[]
  conversations Conversation[]
  userInsights  UserInsight[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  phase     String   @default("opening")
  summary   String?  @db.Text // AI-generated summary for context injection
  isActive  Boolean  @default(true) // Is this the current active conversation?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  insights     ConversationInsight[]
  usageRecords UsageRecord[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  phase          String?
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id               String   @id @default(cuid())
  userId           String
  conversationId   String?
  type             String // "chat", "voice", "summary", "profile", "insights", "tts", "stt"
  category         String   @default("user") // "user", "system", "background"
  service          String   @default("openrouter") // "openrouter", "openai", "elevenlabs", "deepgram", "livekit"
  tokensUsed       Int
  promptTokens     Int?
  completionTokens Int?
  creditsUsed      Int
  costUsd          Float? // Actual USD cost from provider API
  modelId          String?
  source           String? // Code path identifier e.g. "api/chat", "inngest/generate-summary"
  isEstimate       Boolean  @default(false) // true when tokens are estimates, not from provider API
  durationMs       Int? // API call latency or audio duration
  status           String   @default("success") // "success", "error"
  errorMessage     String?  @db.Text
  metadata         Json? // Extensible data (e.g. ElevenLabs chars, Deepgram audio secs)
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@index([userId, type, createdAt])
}

model ConversationInsight {
  id             String   @id @default(cuid())
  conversationId String
  content        String   @db.Text
  type           String // "realization", "assumption", "pattern", "question"
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UserInsight {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text // e.g., "Tends to overthink decisions"
  category   String // "pattern", "preference", "goal", "behavior"
  confidence Float    @default(0.5) // 0-1, how reliable this insight is
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  reference String   @unique
  amount    Int // Amount in kobo
  credits   Int
  status    String   @default("pending") // pending, success, failed
  provider  String   @default("paystack")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
